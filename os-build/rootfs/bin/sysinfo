#!/bin/sh
# Z/OS System Info Command
echo ""
echo "  ╔═══════════════════════════════════════╗"
echo "  ║         Z/OS System Information       ║"
echo "  ╚═══════════════════════════════════════╝"
echo ""
echo "  OS:       Z/OS v0.1 \"Zephyr\""
echo "  Kernel:   $(uname -r)"
echo "  Arch:     $(uname -m)"
echo "  Hostname: $(hostname)"
echo "  Uptime:   $(uptime)"
echo "  Memory:   $(free | head -2 | tail -1 | awk '{print $2}') KB total"
echo "  CPU:      $(cat /proc/cpuinfo | grep "model name" | head -1 | cut -d: -f2 | xargs 2>/dev/null || echo "N/A")"
echo "  Load:     $(cat /proc/loadavg 2>/dev/null || echo "N/A")"
echo ""
