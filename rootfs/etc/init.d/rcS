#!/bin/sh
# TungOS - Ultra-Lightweight Linux
# System initialization script

echo ""
echo "  ████████╗██╗   ██╗ ██████╗ ██╗  ██╗"
echo "  ╚══██╔══╝██║   ██║██╔═══██╗╚██╗██╔╝"
echo "     ██║   ██║   ██║██║   ██║ ╚███╔╝ "
echo "     ██║   ╚██╗ ██╔╝██║   ██║ ██╔██╗ "
echo "     ██║    ╚████╔╝ ╚██████╔╝██╔╝ ██╗"
echo "     ╚═╝     ╚═══╝   ╚═════╝ ╚═╝  ╚═╝"
echo ""
echo "  TungOS v0.1 Zephyr - Ultra-Lightweight Linux"
echo ""

# Mount essential filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# Set hostname
hostname tungos
echo "tungos" > /etc/hostname

# Create essential device nodes
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/null ] || mknod /dev/null c 1 3
[ -e /dev/tty ] || mknod /dev/tty c 5 0
[ -e /dev/zero ] || mknod /dev/zero c 1 5
[ -e /dev/fb0 ] || mknod /dev/fb0 c 29 0

# Setup console
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux

echo "[TungOS] Starting desktop environment..."
echo ""

# Auto-start the TungOS desktop
exec /bin/tungos-desktop
