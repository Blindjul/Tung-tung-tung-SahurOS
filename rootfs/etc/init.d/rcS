#!/bin/sh
# TungOS - Ultra-Lightweight Linux
# System initialization script

echo "TungOS v0.1 Zephyr starting..."

# Mount essential filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/input
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# Set hostname
hostname tungos
echo "tungos" > /etc/hostname

# Create essential device nodes
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/null ] || mknod /dev/null c 1 3
[ -e /dev/tty ] || mknod /dev/tty c 5 0
[ -e /dev/zero ] || mknod /dev/zero c 1 5
[ -e /dev/fb0 ] || mknod /dev/fb0 c 29 0
[ -e /dev/input/mice ] || mknod /dev/input/mice c 13 63
[ -e /dev/input/event0 ] || mknod /dev/input/event0 c 13 64

# Setup
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux

echo "[TungOS] Starting graphical desktop..."
exec /bin/tungos-desktop
